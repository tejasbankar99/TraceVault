# ══════════════════════════════════════════════════════════════════════════════
# TraceVault Backend – Environment Configuration
# Copy this file to .env and fill in your values before running the server.
# NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://tracevault:tracevault_secure_2024@localhost:5432/tracevault
SYNC_DATABASE_URL=postgresql://tracevault:tracevault_secure_2024@localhost:5432/tracevault

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT Authentication ─────────────────────────────────────────────────────────
# IMPORTANT: Replace with a cryptographically random 64-char string in production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── AI / Gemini ────────────────────────────────────────────────────────────────
# Get your API key from: https://ai.google.dev
GOOGLE_API_KEY=your-gemini-api-key-from-ai.google.dev

# ── IP Intelligence ────────────────────────────────────────────────────────────
# Get your token from: https://ipinfo.io/signup
IPINFO_TOKEN=your-ipinfo-token-from-ipinfo.io

# ── Blockchain – Polygon Amoy Testnet (Optional) ───────────────────────────────
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology/
POLYGON_PRIVATE_KEY=your-wallet-private-key-optional
POLYGON_ACCOUNT_ADDRESS=your-wallet-address-optional
ENABLE_BLOCKCHAIN_ANCHORING=false

# ── Evidence Storage ───────────────────────────────────────────────────────────
EVIDENCE_STORE_PATH=/app/evidence_store
MAX_EMAIL_SIZE_MB=25

# ── Application ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
